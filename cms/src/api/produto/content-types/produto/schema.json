{
  "kind": "collectionType",
  "collectionName": "produtos",
  "info": {
    "singularName": "produto",
    "pluralName": "produtos",
    "displayName": "Produto",
    "description": "Peças de cerâmica da Marina"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nome",
      "required": true
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria",
      "inversedBy": "produtos"
    },
    "descricao": {
      "type": "richtext"
    },
    "frase_poetica": {
      "type": "text",
      "maxLength": 240
    },
    "preco": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "fotos": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "situacao": {
      "type": "enumeration",
      "enum": ["em_estoque", "encomenda", "vendido"],
      "required": true,
      "default": "em_estoque"
    },
    "prazo_encomenda_dias": {
      "type": "integer",
      "min": 0
    },
    "destaque": {
      "type": "boolean",
      "default": false
    }
  }
}
