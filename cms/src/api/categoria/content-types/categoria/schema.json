{
  "kind": "collectionType",
  "collectionName": "categorias",
  "info": {
    "singularName": "categoria",
    "pluralName": "categorias",
    "displayName": "Categoria",
    "description": "Tipos de peça (Chicrinhas, Incensários, Cinzeiros...)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nome",
      "required": true
    },
    "foto_capa": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "ordem": {
      "type": "integer",
      "default": 0
    },
    "campos_customizacao": {
      "type": "component",
      "component": "customizacao.campo-customizacao",
      "repeatable": true
    },
    "produtos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::produto.produto",
      "mappedBy": "categoria"
    }
  }
}
